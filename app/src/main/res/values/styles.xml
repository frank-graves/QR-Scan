<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base sin ActionBar: Compose pinta encima. Oscuro por defecto;
         la app decide claro/oscuro en código. -->
    <style name="Theme.Lens" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/backgroundDark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
